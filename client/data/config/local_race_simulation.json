{
  "schema_version": 1,
  "default_delta_s": 0.05,
  "default_max_time_s": 180.0,
  "default_sample_interval_s": 1.0,
  "scenarios": [
    {
      "id": "notch4_cruise",
      "description": "プレイヤーがノッチ4を維持する",
      "player_drive_schedule": [{"start_s": 0.0, "drive_level": 4.0}],
      "goals": [
        {"id": "finish_stamina_near_zero", "kind": "soft", "metric": "player_finish_stamina", "operator": "between", "min": -10.0, "max": 10.0, "target": 0.0, "unit": "%", "reason": "ノッチ4巡航はゴール時スタミナ0%付近（許容範囲: -10〜+10%）"},
        {"id": "finish_heart_rate_normal", "kind": "soft", "metric": "player_finish_heart_rate", "operator": "between", "min": 170.0, "max": 195.0, "target": 180.0, "unit": "bpm", "reason": "ノッチ4巡航の心拍は通常域"},
        {"id": "no_overheat", "kind": "hard", "metric": "player_max_overheat_ratio", "operator": "eq", "target": 0.0, "reason": "ノッチ4巡航ではオーバーヒートしない"}
      ]
    },
    {
      "id": "notch6_sustain",
      "description": "プレイヤーがノッチ6を維持する",
      "player_drive_schedule": [{"start_s": 0.0, "drive_level": 6.0}],
      "goals": [
        {"id": "heart_rate_high_but_bounded", "kind": "soft", "metric": "player_max_heart_rate", "operator": "between", "min": 200.0, "max": 230.0, "target": 220.0, "unit": "bpm", "reason": "ノッチ6長時間維持は高心拍だが共通上限内"},
        {"id": "stamina_debt_bounded", "kind": "hard", "metric": "player_min_stamina", "operator": "gte", "target": -100.0, "unit": "%", "reason": "スタミナ負債は下限-100%を超えない"},
        {"id": "higher_load_than_notch4", "kind": "relative", "metric": "player_stamina_load_l", "operator": "gt", "reference_scenario": "notch4_cruise", "reference_metric": "player_stamina_load_l", "reason": "ノッチ4巡航より燃料負荷が大きい"}
      ]
    },
    {
      "id": "notch6_to_zero_recovery",
      "description": "ノッチ6で走ってからノッチ0へ落として回復を見る",
      "player_drive_schedule": [
        {"start_s": 0.0, "drive_level": 6.0},
        {"start_s": 45.0, "drive_level": 0.0}
      ],
      "goals": [
        {"id": "heart_rate_recovers", "kind": "soft", "metric": "player_finish_heart_rate", "operator": "between", "min": 100.0, "max": 110.0, "target": 105.0, "unit": "bpm", "reason": "ノッチ6から0へ落とすと心拍が100〜110付近へ回復"},
        {"id": "stamina_lower_bound", "kind": "hard", "metric": "player_min_stamina", "operator": "gte", "target": -100.0, "unit": "%", "reason": "回復シナリオでもスタミナ負債の下限を超えない"}
      ]
    },
    {
      "id": "cpu_pack_and_draft",
      "description": "CPUの集団・ドラフト展開を観測する",
      "player_drive_schedule": [{"start_s": 0.0, "drive_level": 4.0}],
      "goals": []
    }
  ]
}

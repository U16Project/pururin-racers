{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "クライアントを起動（Godot）",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/tools/windows/start-godot-client.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-lc",
          "GODOT=\"${workspaceFolder}/tools/godot/Godot_v4.7-stable_linux.x86_64\"; if [[ ! -x \"$GODOT\" ]]; then GODOT=\"/media/u16/Backup/Godot/Godot_v4.7-stable_linux.x86_64\"; fi; if [[ ! -x \"$GODOT\" ]]; then echo \"Godot 4.7 が見つかりません（tools/godot/ を確認）\" >&2; exit 1; fi; exec \"$GODOT\" --path \"${workspaceFolder}/client\""
        ]
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "pururin-client",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Godot Engine"
        }
      }
    }
  ]
}
